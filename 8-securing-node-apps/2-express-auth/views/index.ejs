<html>

<head>
  <title>Express Auth Example</title>
</head>

<body>
  <h1>Welcome to the Express Auth Example!</h1>

  <% if (user) { %>
    <h2>Hello, <%= user.name %>!</h2>
    <p><a href="/auth/logout">Logout</a></p>
  <% } else { %>
    <p><a href="/auth/login">Login</a></p>
  <% } %>
</body>

</html>
